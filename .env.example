PROJECT_NAME="School/College ERP"
API_V1_STR="/api"
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-long-random-secret"
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./backend/school_erp.db"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,zip"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
SAAS_RAZORPAY_KEY_ID=""
SAAS_RAZORPAY_KEY_SECRET=""
SAAS_RAZORPAY_WEBHOOK_SECRET=""
# Production: PostgreSQL URL, configured only in Render environment variables.
# OBJECT_STORAGE_BUCKET="private-school-erp-files"
# OBJECT_STORAGE_ENDPOINT="https://your-s3-compatible-endpoint"
# OBJECT_STORAGE_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="..."
